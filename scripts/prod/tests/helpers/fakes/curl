#!/usr/bin/env bash
# Fake curl driven by a fixture table: "<url><TAB><status><TAB><content-type><TAB><body-file>".
# A URL with no fixture behaves like a real unreachable host (exit 7).
set -u

# shellcheck source=scripts/prod/tests/helpers/fakes/_helpers.bash
. "${FAKE_HELPERS:?FAKE_HELPERS must be set}"
fake_log curl "$@"

out="" write_out="" url="" method=GET
while [ $# -gt 0 ]; do
    case "$1" in
    -o | --output) out="$2"; shift 2 ;;
    -w | --write-out) write_out="$2"; shift 2 ;;
    -X | --request) method="$2"; shift 2 ;;
    -H | --header | --max-time | --data | -d) shift 2 ;;
    -*) shift ;;
    *) url="$1"; shift ;;
    esac
done

# Lets a test mutate the fake world at the exact moment a request is made --
# how a concurrent deployment is simulated.
if [ -n "${FAKE_CURL_HOOK:-}" ] && [ -x "$FAKE_CURL_HOOK" ]; then
    "$FAKE_CURL_HOOK" "$url"
fi

row="$(awk -F'\t' -v u="$url" -v m="$method" '$1 == u && ($5 == "" || $5 == m) { print; exit }' \
    "${FAKE_CURL_FIXTURES:?FAKE_CURL_FIXTURES must be set}")"
if [ -z "$row" ]; then
    echo "curl: (7) Failed to connect" >&2
    exit 7
fi

status="$(printf '%s' "$row" | cut -d"$(printf '\t')" -f2)"
ctype="$(printf '%s' "$row" | cut -d"$(printf '\t')" -f3)"
bodyfile="$(printf '%s' "$row" | cut -d"$(printf '\t')" -f4)"

if [ -n "$out" ]; then
    if [ -n "$bodyfile" ] && [ -f "$bodyfile" ]; then cat "$bodyfile" >"$out"; else : >"$out"; fi
elif [ -n "$bodyfile" ] && [ -f "$bodyfile" ]; then
    cat "$bodyfile"
fi

if [ -n "$write_out" ]; then
    printf '%s' "$write_out" |
        sed -e "s|%{http_code}|$status|g" -e "s|%{content_type}|$ctype|g" -e 's|\\n|\
|g'
fi
