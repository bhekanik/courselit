#!/usr/bin/env bash
# Fake docker CLI. Models just enough of the daemon to let the prod scripts run
# end-to-end in Bats: an image table, a container table, save/load streaming,
# and compose up. State lives in $FAKE_DOCKER_STATE so the same binary can play
# both the local daemon and the remote one (fake ssh swaps the state dir).
set -u

STATE="${FAKE_DOCKER_STATE:?FAKE_DOCKER_STATE must be set}"
mkdir -p "$STATE"
IMAGES="$STATE/images"         # ref \t revision \t platform
CONTAINERS="$STATE/containers" # id \t name \t image \t project \t service \t state \t health \t networks
touch "$IMAGES" "$CONTAINERS"

# shellcheck source=scripts/prod/tests/helpers/fakes/_helpers.bash
. "${FAKE_HELPERS:?FAKE_HELPERS must be set}"
fake_log docker "$@"

die() {
    echo "fake-docker: $*" >&2
    exit 1
}

image_revision() {
    awk -F'\t' -v ref="$1" '$1 == ref { print $2; found = 1 } END { exit !found }' "$IMAGES"
}

# Adds or replaces an image row. Immutability is the deploy script's job to
# enforce, not the daemon's -- the real docker happily reassigns a tag.
image_put() {
    local ref="$1" rev="$2" platform="${3:-}" tmp="$STATE/images.tmp"
    awk -F'\t' -v ref="$ref" '$1 != ref' "$IMAGES" >"$tmp"
    printf '%s\t%s\t%s\n' "$ref" "$rev" "$platform" >>"$tmp"
    mv "$tmp" "$IMAGES"
}

image_platform() {
    local p
    p="$(awk -F'\t' -v ref="$1" '$1 == ref { print $3 }' "$IMAGES")"
    printf '%s' "${p:-linux/amd64}"
}

# A stand-in for the real daemon's layer accounting: enough to prove the harness
# reads and reports a byte size, not a claim about real image sizes.
image_bytes() {
    printf '%s' "${FAKE_IMAGE_BYTES:-1073741824}"
}

container_row() {
    awk -F'\t' -v key="$1" '$1 == key || $2 == key { print; found = 1 } END { exit !found }' "$CONTAINERS"
}

container_field() {
    local row
    row="$(container_row "$1")" || return 1
    printf '%s' "$row" | cut -d"$(printf '\t')" -f"$2"
}

next_container_id() {
    local n
    n="$(cat "$STATE/id-seq" 2>/dev/null || echo 100)"
    n=$((n + 1))
    echo "$n" >"$STATE/id-seq"
    printf 'c%09d' "$n"
}

# Renders the small set of --format templates the prod scripts actually use.
render_format() {
    local fmt="$1" key="$2" row rev
    row="$(container_row "$key")" || die "No such object: $key"
    case "$fmt" in
    *image.revision*)
        rev="$(image_revision "$(printf '%s' "$row" | cut -d"$(printf '\t')" -f3)")" || rev=""
        printf '%s\n' "$rev"
        ;;
    *State.Health*)
        health="$(printf '%s' "$row" | cut -d"$(printf '\t')" -f7)"
        # Lets a test model a container that only reports healthy after a few polls.
        if [ -n "${FAKE_APP_HEALTH_AFTER:-}" ] && [ "$health" != none ]; then
            polls="$(cat "$STATE/health-polls" 2>/dev/null || echo 0)"
            polls=$((polls + 1))
            echo "$polls" >"$STATE/health-polls"
            [ "$polls" -gt "$FAKE_APP_HEALTH_AFTER" ] || health=starting
        fi
        printf '%s\n' "$health"
        ;;
    *State.Status*) printf '%s\n' "$(printf '%s' "$row" | cut -d"$(printf '\t')" -f6)" ;;
    *NetworkSettings.Networks*) printf '%s\n' "$(printf '%s' "$row" | cut -d"$(printf '\t')" -f8)" ;;
    *.Image*) printf '%s\n' "$(printf '%s' "$row" | cut -d"$(printf '\t')" -f3)" ;;
    *) die "unsupported inspect format: $fmt" ;;
    esac
}

cmd_build() {
    local tag="" rev="" platform="" a
    while [ $# -gt 0 ]; do
        a="$1"
        case "$a" in
        --tag) tag="$2"; shift 2 ;;
        --platform) platform="$2"; shift 2 ;;
        --label)
            case "$2" in
            org.opencontainers.image.revision=*) rev="${2#org.opencontainers.image.revision=}" ;;
            esac
            shift 2
            ;;
        *) shift ;;
        esac
    done
    cat >"$STATE/last-build-context"
    [ "${FAKE_DOCKER_BUILD_EXIT:-0}" = "0" ] || return "$FAKE_DOCKER_BUILD_EXIT"
    [ -n "$tag" ] || die "build without --tag"
    image_put "$tag" "${FAKE_BUILD_REVISION:-$rev}" "${FAKE_BUILD_IMAGE_PLATFORM:-$platform}"
}

# Only the flags the migration channel actually passes are modelled; anything
# else is a signal the harness grew a flag its tests never proved.
cmd_run() {
    local image="" a
    while [ $# -gt 0 ]; do
        a="$1"
        case "$a" in
        --rm | -i | -t) shift ;;
        --network | --env-file | -w | --workdir | --entrypoint | -e) shift 2 ;;
        -*) die "unsupported run flag: $a" ;;
        *) image="$1"; shift; break ;;
        esac
    done
    image_revision "$image" >/dev/null || die "run: no such image: $image"
    case "$*" in
    *"test -f"*) [ "${FAKE_MIGRATION_PRESENT:-1}" = 1 ] || return 1 ;;
    *) return "${FAKE_MIGRATION_EXIT:-0}" ;;
    esac
}

compose_image_from_env_files() {
    local env_files="$1" image="" f
    for f in $env_files; do
        [ -f "$f" ] || continue
        image="$(sed -n 's/^AIWS_APP_IMAGE=//p' "$f" | tail -1)"
        [ -n "$image" ] && break
    done
    printf '%s' "$image"
}

cmd_compose() {
    local action="" services="" env_files="" image="" a
    while [ $# -gt 0 ]; do
        a="$1"
        case "$a" in
        --env-file) env_files="$env_files $2"; shift 2 ;;
        -f | --file) shift 2 ;;
        config)
            shift
            image="$(compose_image_from_env_files "$env_files")"
            if [ -n "${FAKE_COMPOSE_CONFIG_REJECT_IMAGE:-}" ] &&
                [ "$image" = "$FAKE_COMPOSE_CONFIG_REJECT_IMAGE" ]; then
                return 1
            fi
            return "${FAKE_COMPOSE_CONFIG_EXIT:-0}"
            ;;
        up)
            action=up
            shift
            ;;
        stop)
            action=stop
            shift
            ;;
        -d | --no-deps | --wait) shift ;;
        *)
            case "$action" in
            up | stop) services="$services $1" ;;
            esac
            shift
            ;;
        esac
    done
    if [ "$action" = stop ]; then
        [ "${FAKE_COMPOSE_STOP_EXIT:-0}" = "0" ] || return "$FAKE_COMPOSE_STOP_EXIT"
        for svc in $services; do
            stop_service "$svc"
        done
        return 0
    fi
    [ "$action" = up ] || return 0
    [ "${FAKE_COMPOSE_UP_EXIT:-0}" = "0" ] || return "$FAKE_COMPOSE_UP_EXIT"

    image="$(compose_image_from_env_files "$env_files")"
    if [ -n "${FAKE_COMPOSE_UP_REJECT_IMAGE:-}" ] &&
        [ "$image" = "$FAKE_COMPOSE_UP_REJECT_IMAGE" ]; then
        return 1
    fi
    # No override layered on: compose uses whatever the live file already pins,
    # so the service keeps the image it is running.
    if [ -n "$image" ]; then
        image_revision "$image" >/dev/null || die "compose up: no such image: $image"
    fi

    local svc
    for svc in $services ${FAKE_COMPOSE_UP_EXTRA_SERVICES:-}; do
        recreate_service "$svc" "$image"
    done
}

stop_service() {
    local svc="$1" tmp="$STATE/containers.tmp"
    awk -F'\t' -v svc="$svc" \
        'BEGIN { OFS = "\t" } $5 == svc { $6 = "stopped" } { print }' \
        "$CONTAINERS" >"$tmp"
    mv "$tmp" "$CONTAINERS"
}

recreate_service() {
    local svc="$1" image="$2" tmp="$STATE/containers.tmp" id
    id="$(next_container_id)"
    awk -F'\t' -v svc="$svc" -v id="$id" -v img="$image" -v health="${FAKE_APP_HEALTH:-healthy}" \
        -v nets="${FAKE_UP_NETWORKS:-}" \
        'BEGIN { OFS = "\t" }
         $5 == svc { $1 = id; if (img != "") $3 = img; $6 = "running"; if ($7 != "none") $7 = health; if (nets != "") $8 = nets }
         { print }' "$CONTAINERS" >"$tmp"
    mv "$tmp" "$CONTAINERS"
}

cmd_ps() {
    local project="" service="" name="" fmt="{{.ID}}" a
    while [ $# -gt 0 ]; do
        a="$1"
        case "$a" in
        --filter)
            case "$2" in
            label=com.docker.compose.project=*) project="${2#label=com.docker.compose.project=}" ;;
            label=com.docker.compose.service=*) service="${2#label=com.docker.compose.service=}" ;;
            name=*) name="${2#name=}" ;;
            esac
            shift 2
            ;;
        --format) fmt="$2"; shift 2 ;;
        *) shift ;;
        esac
    done
    awk -F'\t' -v p="$project" -v s="$service" -v n="$name" -v fmt="$fmt" '
        (p == "" || $4 == p) && (s == "" || $5 == s) && (n == "" || index($2, n)) {
            print (fmt ~ /Names/) ? $2 : $1
        }' "$CONTAINERS"
}

cmd_exec() {
    local interactive=0
    while [ $# -gt 0 ]; do
        case "$1" in
        -i | -it | --interactive) interactive=1; shift ;;
        -t | --tty) shift ;;
        *) break ;;
        esac
    done
    local target="$1" svc script
    shift
    svc="$(container_field "$target" 5)" || die "No such container: $target"
    script="$STATE/exec/$svc"
    [ -x "$script" ] || return 0
    if [ "$interactive" -eq 1 ]; then
        "$script" "$@"
    else
        # Real docker exec only attaches stdin with -i. This matters when the
        # remote script itself arrived through `bash -s`: a non-interactive
        # probe must not consume the rest of that script.
        "$script" "$@" </dev/null
    fi
}

sub="${1:-}"
[ $# -gt 0 ] && shift
case "$sub" in
version)
    case "${1:-}" in
    --format) printf '%s\n' "${FAKE_DOCKER_VERSION:-29.5.3}" ;;
    *) printf 'Docker version %s\n' "${FAKE_DOCKER_VERSION:-29.5.3}" ;;
    esac
    ;;
buildx)
    case "${1:-}" in
    version) printf 'github.com/docker/buildx v0.30.0\n' ;;
    inspect)
        printf 'Name:   default\nDriver: docker\n\n'
        printf 'Platforms: %s\n' "${FAKE_BUILDX_PLATFORMS:-linux/amd64, linux/arm64}"
        ;;
    build)
        shift
        cmd_build "$@"
        ;;
    *) die "unsupported buildx subcommand: ${1:-}" ;;
    esac
    ;;
image)
    case "${1:-}" in
    inspect)
        shift
        fmt=""
        [ "${1:-}" = "--format" ] && { fmt="$2"; shift 2; }
        rev="$(image_revision "${1:-}")" || {
            echo "Error: No such image: ${1:-}" >&2
            exit 1
        }
        case "$fmt" in
        *image.revision*) printf '%s\n' "$rev" ;;
        *Architecture*) printf '%s\n' "$(image_platform "${1:-}")" ;;
        *Size*) printf '%s\n' "$(image_bytes)" ;;
        "") : ;;
        *) printf '%s\n' "${1:-}" ;;
        esac
        ;;
    *) die "unsupported image subcommand: ${1:-}" ;;
    esac
    ;;
save)
    ref="${1:-}"
    rev="$(image_revision "$ref")" || {
        echo "Error: No such image: $ref" >&2
        exit 1
    }
    [ "${FAKE_DOCKER_SAVE_EXIT:-0}" = "0" ] || exit "$FAKE_DOCKER_SAVE_EXIT"
    printf 'FAKEIMAGE\t%s\t%s\n' "$ref" "$rev"
    ;;
load)
    [ "${FAKE_DOCKER_LOAD_EXIT:-0}" = "0" ] || exit "$FAKE_DOCKER_LOAD_EXIT"
    # Real `docker load` sniffs the stream and decompresses gzip itself.
    stream="$STATE/incoming"
    cat >"$stream"
    if gzip -t "$stream" 2>/dev/null; then
        echo gzip >"$STATE/last-load-encoding"
        gzip -dc "$stream" >"$stream.tar"
    else
        echo plain >"$STATE/last-load-encoding"
        cp "$stream" "$stream.tar"
    fi
    while IFS="$(printf '\t')" read -r marker ref rev; do
        [ "$marker" = "FAKEIMAGE" ] || continue
        image_put "$ref" "${FAKE_LOAD_REVISION:-$rev}"
        printf 'Loaded image: %s\n' "$ref"
    done <"$stream.tar"
    ;;
inspect)
    fmt=""
    case "${1:-}" in
    -f | --format) fmt="$2"; shift 2 ;;
    esac
    render_format "$fmt" "${1:-}"
    ;;
ps) cmd_ps "$@" ;;
compose) cmd_compose "$@" ;;
run) cmd_run "$@" ;;
exec) cmd_exec "$@" ;;
push | pull) exit 0 ;;
*) die "unsupported command: $sub" ;;
esac
