  "page": {
    "pageId": "homepage",
    "name": "Home",
    "type": "site",
    "entityIdSource": "domain.name",
    "creatorIdSource": "domain-owner.userId",
    "title": "AI for actual work | AI Work School",
    "description": "A free practical course for professionals who want to use AI on real work, check the result, and leave a method others can follow.",
    "robotsAllowed": true,
    "draftTitleSource": "page.title",
    "draftDescriptionSource": "page.description",
    "draftRobotsAllowedSource": "page.robotsAllowed",
    "draftLayoutSource": "page.layout",
    "layout": [
      {
        "widgetId": "widget_ai_work_school_header_v1",
        "name": "header",
        "deleteable": false,
        "shared": true
      },
      {
        "widgetId": "widget_ai_work_school_managed_v1",
        "name": "rich-text",
        "deleteable": true,
        "shared": false,
        "settings": {
          "type": "site",
          "verticalPadding": "py-4",
          "maxWidth": "max-w-6xl",
          "alignment": "left",
          "fontSize": 3,
          "text": {
            "type": "doc",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "marks": [
                      {
                        "type": "bold"
                      }
                    ],
                    "text": "Free course. 7 sections. 14 lessons."
                  }
                ]
              }
            ]
          }
        }
      },
      {
        "widgetId": "widget_ai_work_school_hero_v1",
        "name": "hero",
        "deleteable": true,
        "shared": false,
        "settings": {
          "type": "site",
          "verticalPadding": "py-24",
          "maxWidth": "max-w-5xl",
          "title": "Bring one real task. Build a workflow you can trust.",
          "description": {
            "type": "doc",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "This free course shows you how to brief AI with the context of your job, check what it produces, and leave a record another person can follow. You finish with a working method for a task you already need to do."
                  }
                ]
              }
            ]
          },
          "buttonCaption": "Start the free course",
          "buttonAction": "/course/ai-for-actual-work/course_ai_for_actual_work_v1",
          "alignment": "left",
          "titleFontSize": 5,
          "descriptionFontSize": 1,
          "contentAlignment": "left",
          "layout": "normal"
        }
      },
      {
        "widgetId": "widget_ai_work_school_outline_v1",
        "name": "grid",
        "deleteable": true,
        "shared": false,
        "settings": {
          "type": "site",
          "verticalPadding": "py-20",
          "maxWidth": "max-w-6xl",
          "title": "The work, in order",
          "description": {
            "type": "doc",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Four moves turn a promising answer into work you can use and defend."
                  }
                ]
              }
            ]
          },
          "headerAlignment": "left",
          "itemsAlignment": "left",
          "columns": 2,
          "items": [
            {
              "title": "1. Give the work its context",
              "description": {
                "type": "doc",
                "content": [
                  {
                    "type": "paragraph",
                    "content": [
                      {
                        "type": "text",
                        "text": "Turn scattered notes, constraints and examples into a working brief. Decide what the system may use, what it must not infer, and what a good result has to contain."
                      }
                    ]
                  }
                ]
              }
            },
            {
              "title": "2. Choose a chat, saved instruction or workflow",
              "description": {
                "type": "doc",
                "content": [
                  {
                    "type": "paragraph",
                    "content": [
                      {
                        "type": "text",
                        "text": "Use a focused conversation for exploration, a saved instruction for repeatable work, or a workflow when the hand-offs and checks must run in order. The task sets the shape."
                      }
                    ]
                  }
                ]
              }
            },
            {
              "title": "3. Set checks that can fail",
              "description": {
                "type": "doc",
                "content": [
                  {
                    "type": "paragraph",
                    "content": [
                      {
                        "type": "text",
                        "text": "Write a source contract and a short acceptance list before you accept an answer. Check facts, omissions and judgement where they matter."
                      }
                    ]
                  }
                ]
              }
            },
            {
              "title": "4. Leave a usable record",
              "description": {
                "type": "doc",
                "content": [
                  {
                    "type": "paragraph",
                    "content": [
                      {
                        "type": "text",
                        "text": "Keep the decision, evidence and next action together. A colleague should be able to see what was done and where human judgement entered."
                      }
                    ]
                  }
                ]
              }
            }
          ]
        }
      },
      {
        "widgetId": "widget_ai_work_school_outputs_v1",
        "name": "rich-text",
        "deleteable": true,
        "shared": false,
        "settings": {
          "type": "site",
          "verticalPadding": "py-20",
          "maxWidth": "max-w-4xl",
          "alignment": "left",
          "fontSize": 4,
          "text": {
            "type": "doc",
            "content": [
              {
                "type": "heading",
                "attrs": {
                  "level": 2
                },
                "content": [
                  {
                    "type": "text",
                    "text": "Work you can keep"
                  }
                ]
              },
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Use one real task throughout the course. Each lesson adds something you can take back to work:"
                  }
                ]
              },
              {
                "type": "bulletList",
                "content": [
                  {
                    "type": "listItem",
                    "content": [
                      {
                        "type": "paragraph",
                        "content": [
                          {
                            "type": "text",
                            "text": "a working brief with the audience, constraints, sources and finish condition;"
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "type": "listItem",
                    "content": [
                      {
                        "type": "paragraph",
                        "content": [
                          {
                            "type": "text",
                            "text": "a source contract and checks that expose an unsupported or incomplete answer;"
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "type": "listItem",
                    "content": [
                      {
                        "type": "paragraph",
                        "content": [
                          {
                            "type": "text",
                            "text": "a decision record that says what you accepted, changed and rejected;"
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "type": "listItem",
                    "content": [
                      {
                        "type": "paragraph",
                        "content": [
                          {
                            "type": "text",
                            "text": "a closing note that gives the next person the evidence and next action."
                          }
                        ]
                      }
                    ]
                  }
                ]
              },
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "The core course needs no code. If you write software, an optional engineering extension applies the same discipline to repositories, tests and changes."
                  }
                ]
              }
            ]
          }
        }
      },
      {
        "widgetId": "widget_ai_work_school_course_v1",
        "name": "hero",
        "deleteable": true,
        "shared": false,
        "settings": {
          "type": "site",
          "verticalPadding": "py-20",
          "maxWidth": "max-w-4xl",
          "background": {
            "type": "color",
            "backgroundColor": "#f8e5eb",
            "backgroundColorDark": "#321b27"
          },
          "title": "AI for actual work",
          "description": {
            "type": "doc",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Bring a task with a real audience, source material and a consequence if the answer is wrong. The course helps you turn it into a working method you can check and explain."
                  }
                ]
              }
            ]
          },
          "buttonCaption": "Start the free course",
          "buttonAction": "/course/ai-for-actual-work/course_ai_for_actual_work_v1",
          "alignment": "left",
          "titleFontSize": 4,
          "descriptionFontSize": 1,
          "contentAlignment": "left",
          "layout": "normal"
        }
      },
      {
        "widgetId": "widget_ai_work_school_faq_v1",
        "name": "faq",
        "deleteable": true,
        "shared": false,
        "settings": {
          "type": "site",
          "verticalPadding": "py-20",
          "maxWidth": "max-w-6xl",
          "title": "Before you start",
          "description": {
            "type": "doc",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Bring the work. The course supplies the method."
                  }
                ]
              }
            ]
          },
          "headerAlignment": "left",
          "itemsAlignment": "left",
          "layout": "horizontal",
          "items": [
            {
              "title": "Do I need to write code?",
              "description": {
                "type": "doc",
                "content": [
                  {
                    "type": "paragraph",
                    "content": [
                      {
                        "type": "text",
                        "text": "No. The core course is for professional work such as research, analysis, planning, writing and decisions. Engineering material is clearly marked as an optional extension."
                      }
                    ]
                  }
                ]
              }
            },
            {
              "title": "What kind of work should I bring?",
              "description": {
                "type": "doc",
                "content": [
                  {
                    "type": "paragraph",
                    "content": [
                      {
                        "type": "text",
                        "text": "Choose a real task with a known audience, source material and a result someone will use. A supplier review, hiring scorecard, board summary or incident write-up all work."
                      }
                    ]
                  }
                ]
              }
            },
            {
              "title": "What should I do with sensitive material?",
              "description": {
                "type": "doc",
                "content": [
                  {
                    "type": "paragraph",
                    "content": [
                      {
                        "type": "text",
                        "text": "Follow your organisation's rules and use an approved environment. Remove personal information, secrets and confidential material when you do not have permission to share them. Use safe stand-ins for the exercise."
                      }
                    ]
                  }
                ]
              }
            },
            {
              "title": "Does this depend on one AI tool?",
              "description": {
                "type": "doc",
                "content": [
                  {
                    "type": "paragraph",
                    "content": [
                      {
                        "type": "text",
                        "text": "No. The course is organised around context, sources, checks, decisions and handover. Apply those practices in the tool your work permits."
                      }
                    ]
                  }
                ]
              }
            }
          ]
        }
      },
      {
        "widgetId": "widget_ai_work_school_footer_v1",
        "name": "footer",
        "deleteable": false,
        "shared": true
      }
    ]
  }
