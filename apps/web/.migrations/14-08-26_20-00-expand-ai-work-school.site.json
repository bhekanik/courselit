        "name": "rich-text",
        "deleteable": true,
        "shared": false,
        "settings": {
          "type": "site",
          "verticalPadding": "py-16",
          "maxWidth": "max-w-4xl",
          "alignment": "left",
          "fontSize": 4,
          "text": {
            "type": "doc",
            "content": [
              {
                "type": "heading",
                "attrs": {
                  "level": 2
                },
                "content": [
                  {
                    "type": "text",
                    "text": "From first brief to finished handover."
                  }
                ]
              },
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Follow one real job from initial context and permission through checks, decisions and handover."
                  }
                ]
              },
              {
                "type": "orderedList",
                "content": [
                  {
                    "type": "listItem",
                    "content": [
                      {
                        "type": "paragraph",
                        "content": [
                          {
                            "type": "text",
                            "marks": [
                              {
                                "type": "bold"
                              }
                            ],
                            "text": "Start with real work. "
                          },
                          {
                            "type": "text",
                            "text": "Choose a recurring, low-risk job and describe what a useful result must do."
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "type": "listItem",
                    "content": [
                      {
                        "type": "paragraph",
                        "content": [
                          {
                            "type": "text",
                            "marks": [
                              {
                                "type": "bold"
                              }
                            ],
                            "text": "Build context that survives the session. "
                          },
                          {
                            "type": "text",
                            "text": "Write reusable rules and say when they need an update."
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "type": "listItem",
                    "content": [
                      {
                        "type": "paragraph",
                        "content": [
                          {
                            "type": "text",
                            "marks": [
                              {
                                "type": "bold"
                              }
                            ],
                            "text": "Choose the mechanism before the prompt. "
                          },
                          {
                            "type": "text",
                            "text": "Match policy, workflow or agent to the job, then inspect the process underneath it."
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "type": "listItem",
                    "content": [
                      {
                        "type": "paragraph",
                        "content": [
                          {
                            "type": "text",
                            "marks": [
                              {
                                "type": "bold"
                              }
                            ],
                            "text": "Build checks that can prove you wrong. "
                          },
                          {
                            "type": "text",
                            "text": "Derive acceptance conditions from the brief and fail cheaply before anything changes."
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "type": "listItem",
                    "content": [
                      {
                        "type": "paragraph",
                        "content": [
                          {
                            "type": "text",
                            "marks": [
                              {
                                "type": "bold"
                              }
                            ],
                            "text": "Make consequential work inspectable. "
                          },
                          {
                            "type": "text",
                            "text": "Stop on missing context and leave a replayable decision trace."
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "type": "listItem",
                    "content": [
                      {
                        "type": "paragraph",
                        "content": [
                          {
                            "type": "text",
                            "marks": [
                              {
                                "type": "bold"
                              }
                            ],
                            "text": "Close delegated work properly. "
                          },
                          {
                            "type": "text",
                            "text": "Verify that done is true and plan for automation failure."
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "type": "listItem",
                    "content": [
                      {
                        "type": "paragraph",
                        "content": [
                          {
                            "type": "text",
                            "marks": [
                              {
                                "type": "bold"
                              }
                            ],
                            "text": "Choose the work surface. "
                          },
                          {
                            "type": "text",
                            "text": "Separate quick conversations from work that needs delegation and review."
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "type": "listItem",
                    "content": [
                      {
                        "type": "paragraph",
                        "content": [
                          {
                            "type": "text",
                            "marks": [
                              {
                                "type": "bold"
                              }
                            ],
                            "text": "Package repeated work. "
                          },
                          {
                            "type": "text",
                            "text": "Turn a repeated job into a reusable skill and govern its connections."
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "type": "listItem",
                    "content": [
                      {
                        "type": "paragraph",
                        "content": [
                          {
                            "type": "text",
                            "marks": [
                              {
                                "type": "bold"
                              }
                            ],
                            "text": "Research and write with evidence. "
                          },
                          {
                            "type": "text",
                            "text": "Research before drafting, then edit the argument and the prose."
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "type": "listItem",
                    "content": [
                      {
                        "type": "paragraph",
                        "content": [
                          {
                            "type": "text",
                            "marks": [
                              {
                                "type": "bold"
                              }
                            ],
                            "text": "Produce work and act safely. "
                          },
                          {
                            "type": "text",
                            "text": "Build checked artefacts and act only with explicit authority."
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "type": "listItem",
                    "content": [
                      {
                        "type": "paragraph",
                        "content": [
                          {
                            "type": "text",
                            "marks": [
                              {
                                "type": "bold"
                              }
                            ],
                            "text": "Keep the understanding and improve the setup. "
                          },
                          {
                            "type": "text",
                            "text": "Turn misses into better rules, checks and handovers."
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            ]
          }
        }
      },
      {
        "widgetId": "widget_ai_work_school_fit_v2",
        "name": "grid",
        "deleteable": true,
        "shared": false,
        "settings": {
          "type": "site",
          "verticalPadding": "py-16",
          "maxWidth": "max-w-6xl",
          "title": "Check the fit",
          "description": {
            "type": "doc",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "The course works best when the job is real, bounded and safe to practise with."
                  }
                ]
              }
            ]
          },
          "headerAlignment": "left",
          "itemsAlignment": "left",
          "columns": 2,
          "items": [
            {
              "title": "This is for you if",
              "description": {
                "type": "doc",
                "content": [
                  {
                    "type": "paragraph",
                    "content": [
                      {
                        "type": "text",
                        "text": "You have a recurring, low-risk job with a known audience and source material, and you are willing to inspect the result before anyone uses it."
                      }
                    ]
                  }
                ]
              }
            },
            {
              "title": "This is not for you if",
              "description": {
                "type": "doc",
                "content": [
                  {
                    "type": "paragraph",
                    "content": [
                      {
                        "type": "text",
                        "text": "You want one magic prompt, cannot use an approved environment, or expect AI to make a final high-consequence decision without human review."
                      }
                    ]
                  }
                ]
              }
            }
          ]
        }
      },
      {
        "widgetId": "widget_ai_work_school_closing_v2",
        "name": "hero",
        "deleteable": true,
        "shared": false,
        "settings": {
          "type": "site",
          "verticalPadding": "py-12",
          "maxWidth": "max-w-4xl",
          "title": "Bring one job. Leave with a method. Free.",
          "description": {
            "type": "doc",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Start with work you already understand. Finish with a workflow another person can inspect."
                  }
                ]
              }
            ]
          },
          "buttonCaption": "Start the course — free",
          "buttonAction": "/course/ai-for-actual-work/course_ai_for_actual_work_v1",
          "alignment": "left",
          "contentAlignment": "left",
          "layout": "normal"
        }
      },
      {
        "widgetId": "widget_ai_work_school_faq_v2",
        "name": "faq",
        "deleteable": true,
        "shared": false,
        "settings": {
          "type": "site",
          "verticalPadding": "py-16",
          "maxWidth": "max-w-6xl",
          "title": "Before you start",
          "description": {
            "type": "doc",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Bring the work. The course supplies the method."
                  }
                ]
              }
            ]
          },
          "headerAlignment": "left",
          "itemsAlignment": "left",
          "layout": "horizontal",
          "items": [
            {
              "title": "How much does the course cost?",
              "description": {
                "type": "doc",
                "content": [
                  {
                    "type": "paragraph",
                    "content": [
                      {
                        "type": "text",
                        "text": "Nothing. The course is free."
                      }
                    ]
                  }
                ]
              }
            },
            {
              "title": "Do I need to write code?",
              "description": {
                "type": "doc",
                "content": [
                  {
                    "type": "paragraph",
                    "content": [
                      {
                        "type": "text",
                        "text": "No. The core course covers research, analysis, planning, writing and decisions. Engineering material is an optional extension."
                      }
                    ]
                  }
                ]
              }
            },
            {
              "title": "What kind of work should I bring?",
              "description": {
                "type": "doc",
                "content": [
                  {
                    "type": "paragraph",
                    "content": [
                      {
                        "type": "text",
                        "text": "Choose a recurring, low-risk job with a known audience, source material and a result someone will use. Avoid practising on a one-off crisis or an irreversible decision."
                      }
                    ]
                  }
                ]
              }
            },
            {
              "title": "What if my company has rules about AI?",
              "description": {
                "type": "doc",
                "content": [
                  {
                    "type": "paragraph",
                    "content": [
                      {
                        "type": "text",
                        "text": "Follow them. Use only approved tools, sources and accounts. If the exercise conflicts with policy, use a safe stand-in instead."
                      }
                    ]
                  }
                ]
              }
            },
            {
              "title": "What should I do with sensitive material?",
              "description": {
                "type": "doc",
                "content": [
                  {
                    "type": "paragraph",
                    "content": [
                      {
                        "type": "text",
                        "text": "Do not paste in personal information, secrets or confidential material without permission. Remove identifying details or use representative sample data."
                      }
                    ]
                  }
                ]
              }
            },
            {
              "title": "Does this depend on one AI tool?",
              "description": {
                "type": "doc",
                "content": [
                  {
                    "type": "paragraph",
                    "content": [
                      {
                        "type": "text",
                        "text": "No. The course is organised around context, permission, sources, checks, decisions and handover. Apply those practices in the tool your work permits."
                      }
                    ]
                  }
                ]
              }
            }
          ]
        }
      },
      {
        "widgetId": "widget_ai_work_school_footer_v1",
        "name": "footer",
        "deleteable": false,
        "shared": true
      }
    ]
  }
}
