        "name": "hero",
        "deleteable": true,
        "shared": false,
        "settings": {
          "type": "site",
          "verticalPadding": "py-20",
          "maxWidth": "max-w-6xl",
          "title": "Do one real job with AI, and show your working.",
          "description": {
            "type": "doc",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "A free course for working professionals. Bring one recurring, low-risk job you already do. Leave with a workflow that you, and anyone who reviews it, can inspect."
                  }
                ]
              }
            ]
          },
          "buttonCaption": "Start the course — free",
          "buttonAction": "/course/ai-for-actual-work/course_ai_for_actual_work_v1",
          "alignment": "right",
          "contentAlignment": "left",
          "layout": "normal",
          "mobileMediaPlacement": "after-content",
          "mediaRadius": 4,
          "objectFit": "cover",
          "media": {
            "access": "public",
            "caption": "Three colleagues at a shared table, comparing a printed page, a spreadsheet and a workflow shown step by step on screen.",
            "file": "https://media.bhekani.com/p/Z3Q6cc-g_1zN5ZFUoVoDUHuGBEUmISJPMlcu6Z1o/main.webp",
            "mediaId": "Z3Q6cc-g_1zN5ZFUoVoDUHuGBEUmISJPMlcu6Z1o",
            "mimeType": "image/webp",
            "originalFileName": "hero-real-work.webp",
            "size": 391886,
            "thumbnail": "https://media.bhekani.com/p/Z3Q6cc-g_1zN5ZFUoVoDUHuGBEUmISJPMlcu6Z1o/thumb.webp"
          }
        }
      },
      {
        "widgetId": "widget_ai_work_school_managed_v1",
        "name": "rich-text",
        "deleteable": true,
        "shared": false,
        "settings": {
          "type": "site",
          "verticalPadding": "py-4",
          "maxWidth": "max-w-6xl",
          "alignment": "left",
          "fontSize": 3,
          "text": {
            "type": "doc",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "marks": [
                      {
                        "type": "bold"
                      }
                    ],
                    "text": "Free · Bring one job you already do · No coding"
                  }
                ]
              }
            ]
          }
        }
      },
      {
        "widgetId": "widget_ai_work_school_tool_choice_v2",
        "name": "rich-text",
        "deleteable": true,
        "shared": false,
        "settings": {
          "type": "site",
          "verticalPadding": "py-16",
          "maxWidth": "max-w-4xl",
          "alignment": "left",
          "fontSize": 4,
          "text": {
            "type": "doc",
            "content": [
              {
                "type": "heading",
                "attrs": {
                  "level": 2
                },
                "content": [
                  {
                    "type": "text",
                    "text": "Choose the shape of the job, not the brand of the tool."
                  }
                ]
              },
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Tools change. The job does not. Decide whether you need a one-off answer, a reusable skill, or a governed connection to approved sources. Then match the mechanism to the risk and repeatability of the work."
                  }
                ]
              },
              {
                "type": "orderedList",
                "content": [
                  {
                    "type": "listItem",
                    "content": [
                      {
                        "type": "paragraph",
                        "content": [
                          {
                            "type": "text",
                            "text": "One-off question: use a chat, then check the answer yourself."
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "type": "listItem",
                    "content": [
                      {
                        "type": "paragraph",
                        "content": [
                          {
                            "type": "text",
                            "text": "Same job, repeated: pack the context, steps, examples and checks as a reusable skill."
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "type": "listItem",
                    "content": [
                      {
                        "type": "paragraph",
                        "content": [
                          {
                            "type": "text",
                            "text": "Needs approved files or systems: connect the source behind a permission gate."
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "type": "listItem",
                    "content": [
                      {
                        "type": "paragraph",
                        "content": [
                          {
                            "type": "text",
                            "text": "Higher consequence: another person checks it before it leaves."
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            ]
          }
        }
      },
      {
        "widgetId": "widget_ai_work_school_tool_selection_v2",
        "name": "media",
        "deleteable": true,
        "shared": false,
        "settings": {
          "type": "site",
          "verticalPadding": "py-4",
          "maxWidth": "max-w-4xl",
          "media": {
            "access": "public",
            "caption": "A decision guide: use chat for a one-off question, package a repeated job as a skill, put approved files or systems behind a permission gate, and add another reviewer when consequences rise.",
          "file": "https://media.bhekani.com/p/LVfN0wtYWPs3G57bzULRMnia6PHReN_AI_k6hc32/main.webp",
            "mediaId": "LVfN0wtYWPs3G57bzULRMnia6PHReN_AI_k6hc32",
            "mimeType": "image/webp",
            "originalFileName": "diagram-tool-selection.webp",
            "size": 57326,
            "thumbnail": "https://media.bhekani.com/p/LVfN0wtYWPs3G57bzULRMnia6PHReN_AI_k6hc32/thumb.webp"
          },
          "mediaRadius": 4,
          "objectFit": "contain",
          "hasBorder": false
        }
      },
      {
        "widgetId": "widget_ai_work_school_artefacts_v2",
        "name": "rich-text",
        "deleteable": true,
        "shared": false,
        "settings": {
          "type": "site",
          "verticalPadding": "py-16",
          "maxWidth": "max-w-4xl",
          "alignment": "left",
          "fontSize": 4,
          "text": {
            "type": "doc",
            "content": [
              {
                "type": "heading",
                "attrs": {
                  "level": 2
                },
                "content": [
                  {
                    "type": "text",
                    "text": "Five artefacts, one job."
                  }
                ]
              },
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                "text": "The capstone consolidates your lesson records into five reviewable files you can keep, inspect and hand to someone else."
                  }
                ]
              },
              {
                "type": "bulletList",
                "content": [
                  {
                    "type": "listItem",
                    "content": [
                      {
                        "type": "paragraph",
                        "content": [
                          {
                            "type": "text",
                            "marks": [
                              {
                                "type": "bold"
                              }
                            ],
                    "text": "Working brief (working-brief.md). "
                          },
                          {
                            "type": "text",
                    "text": "The audience, constraints, permission and finish condition for the job."
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "type": "listItem",
                    "content": [
                      {
                        "type": "paragraph",
                        "content": [
                          {
                            "type": "text",
                            "marks": [
                              {
                                "type": "bold"
                              }
                            ],
                    "text": "Source contract (source-contract.md). "
                          },
                          {
                            "type": "text",
                            "text": "What the work may use, what it must not infer and where each claim comes from."
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "type": "listItem",
                    "content": [
                      {
                        "type": "paragraph",
                        "content": [
                          {
                            "type": "text",
                            "marks": [
                              {
                                "type": "bold"
                              }
                            ],
                    "text": "Checks and evidence (checks-and-evidence.md). "
                          },
                          {
                            "type": "text",
                            "text": "Conditions that can expose a missing, unsupported or unsafe result."
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "type": "listItem",
                    "content": [
                      {
                        "type": "paragraph",
                        "content": [
                          {
                            "type": "text",
                            "marks": [
                              {
                                "type": "bold"
                              }
                            ],
                    "text": "Decision record (decision-record.md). "
                          },
                          {
                            "type": "text",
                            "text": "What you accepted, changed or rejected, with the reason."
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "type": "listItem",
                    "content": [
                      {
                        "type": "paragraph",
                        "content": [
                          {
                            "type": "text",
                            "marks": [
                              {
                                "type": "bold"
                              }
                            ],
                    "text": "Handover (handover.md). "
                          },
                          {
                            "type": "text",
                            "text": "The result, evidence, open questions and next action in one place."
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            ]
          }
        }
